--- a/application/vlc-android/src/org/videolan/vlc/gui/video/VideoPlayerActivity.kt
+++ b/application/vlc-android/src/org/videolan/vlc/gui/video/VideoPlayerActivity.kt
@@ -1443,18 +1443,78 @@ open class VideoPlayerActivity : AppCompatActivity(), PlaybackService.Callback,
     }
 
     override fun next() {
-        if (service?.hasNext() == true) {
-            service?.next()
+        val activeService = service ?: return
+        if (activeService.hasNext()) {
+            activeService.next()
             overlayDelegate.showInfo(getString(R.string.next), 1000)
             overlayDelegate.showOverlay()
+        } else {
+            navigateVideoInCurrentFolder(1)
         }
     }
 
     override fun previous() {
-        service?.let { service ->
-            service.previous(false)
+        val activeService = service ?: return
+        if (activeService.hasPrevious()) {
+            activeService.previous(true)
             overlayDelegate.showInfo(getString(R.string.previous), 1000)
             overlayDelegate.showOverlay()
+        } else {
+            navigateVideoInCurrentFolder(-1)
+        }
+    }
+
+    /**
+     * File-manager launches often give VLC a one-item playlist. When that happens,
+     * use the media library to build a naturally sorted queue from the same local
+     * folder so the on-screen Previous/Next buttons can move between sibling videos.
+     * SAF/network/stream items keep the normal VLC playlist behavior.
+     */
+    private fun navigateVideoInCurrentFolder(direction: Int) {
+        val activeService = service ?: return
+        val current = activeService.currentMediaWrapper ?: return
+        lifecycleScope.launch {
+            val queueData = withContext(Dispatchers.IO) {
+                // MediaStore launches can arrive as content:// URIs. Resolve those
+                // back to the media-library file URI when Android exposes a path.
+                val queueCurrent = if (current.uri.scheme == "content") {
+                    val resolved = FileUtils.getPathFromURI(current.uri)
+                    if (resolved.startsWith("file://")) medialibrary.getMedia(resolved.toUri()) ?: current else current
+                } else current
+                val localUri = queueCurrent.uri.takeIf { it.scheme == "file" }
+                    ?: return@withContext Pair(null, emptyList<MediaWrapper>())
+                val currentParent = FileUtils.getParent(localUri.toString())
+                    ?: return@withContext Pair(null, emptyList<MediaWrapper>())
+                val videos = medialibrary.getVideos()
+                    .filter { it.uri.scheme == "file" && FileUtils.getParent(it.uri.toString()) == currentParent }
+                    .distinctBy { it.uri.toString() }
+                    .toMutableList()
+                if (videos.none { it.uri == localUri }) videos.add(queueCurrent)
+                Pair(localUri, videos.sortedBy { it.uri.lastPathSegment?.lowercase().orEmpty() })
+            }
+            val currentPlaylistUri = queueData.first
+            val siblingVideos = queueData.second
+            if (currentPlaylistUri == null) {
+                Toast.makeText(
+                    this@VideoPlayerActivity,
+                    if (direction > 0) R.string.no_next_video_available else R.string.no_previous_video_available,
+                    Toast.LENGTH_SHORT
+                ).show()
+                return@launch
+            }
+            val currentIndex = siblingVideos.indexOfFirst { it.uri == currentPlaylistUri }
+            val targetIndex = currentIndex + direction
+            if (currentIndex < 0 || targetIndex !in siblingVideos.indices) {
+                Toast.makeText(
+                    this@VideoPlayerActivity,
+                    if (direction > 0) R.string.no_next_video_in_folder else R.string.no_previous_video_in_folder,
+                    Toast.LENGTH_SHORT
+                ).show()
+                return@launch
+            }
+            activeService.load(siblingVideos, targetIndex)
+            overlayDelegate.showInfo(getString(if (direction > 0) R.string.next else R.string.previous), 1000)
+            overlayDelegate.showOverlay()
         }
     }
 
